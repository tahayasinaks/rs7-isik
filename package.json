{
  "name": "rs7-isik",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "ATK RS7 Air için Türkçe aydınlatma denemeleri",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test",
    "desktop": "node desktop/build-helper.cjs && electron .",
    "dist:win": "node desktop/build-helper.cjs && electron-builder --win portable --x64 --publish never"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.rs7isik.app",
    "productName": "RS7 Işık",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "src/**",
      "index.html",
      "style.css",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop/bin/RS7-Keys.exe",
        "to": "RS7-Keys.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "RS7-Isik-${version}-Windows-x64.exe"
    }
  }
}
